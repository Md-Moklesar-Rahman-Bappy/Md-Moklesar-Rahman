# Admin password for the dashboard (change this!)
VITE_ADMIN_PASSWORD=admin123

# GitHub personal access token (for committing file changes from admin dashboard)
# Create at: https://github.com/settings/tokens (needs repo scope)
VITE_GITHUB_TOKEN=your_github_token

# GitHub repository info
VITE_GITHUB_OWNER=your_github_username
VITE_GITHUB_REPO=your_repo_name
